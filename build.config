# OnePlus SDM845 kernel build configuration
# Edit this file to customize the build. Values are consumed by build.sh.

# OnePlus 6 (enchilada) defconfig. The selected defconfig already enables:
# CONFIG_NOMOUNT=y, CONFIG_SECCOMP=y and CONFIG_SECCOMP_FILTER=y.
KERNEL_DEFCONFIG="enchilada_defconfig"

ARCH="arm64"
SUBARCH="arm64"

# GNU cross toolchains. Override these prefixes if your toolchains use
# different names or absolute paths.
CROSS_COMPILE="aarch64-linux-gnu-"
CROSS_COMPILE_ARM32="arm-linux-gnueabi-"

# Leave CC empty to use the compiler selected by CROSS_COMPILE.
# For a Clang build, set CC="clang" and configure CLANG_TRIPLE below.
CC=""
CLANG_TRIPLE="aarch64-linux-gnu-"

# Build output and artifact directories (relative to the repository root
# unless absolute paths are supplied).
OUT_DIR="out"
DIST_DIR="dist"

# Number of parallel jobs. 0 means use all available logical CPUs.
BUILD_JOBS=0

# Image.gz-dtb builds the compressed ARM64 kernel with appended DTB.
BUILD_TARGET="Image.gz-dtb"

# Set to 1 to show full compiler commands.
VERBOSE=0
